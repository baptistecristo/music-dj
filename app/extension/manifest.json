{
  "manifest_version": 3,
  "name": "music-dj-bridge",
  "version": "0.1.0",
  "description": "Bridges the local music-dj daemon to the Apple Music web player.",
  "key": "",
  "permissions": ["alarms", "storage", "scripting", "nativeMessaging"],
  "action": { "default_title": "music DJ — click to start or stop" },
  "host_permissions": [
    "https://music.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["bridge-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["bridge-iso.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
