{
  "manifest_version": 3,
  "name": "music-dj-bridge",
  "version": "0.9.0",
  "description": "Bridges the local music-dj daemon to the Apple Music web player.",
  "key": "",
  "permissions": ["alarms", "storage", "scripting", "nativeMessaging"],
  "action": {
    "default_title": "music DJ — click to start or stop",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "https://music.apple.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "music-dj@baptistecristo.github.io",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["bridge-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://music.apple.com/*"],
      "js": ["bridge-iso.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
